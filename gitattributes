# =============================================================================
# Unity .gitattributes
# Cross-platform: Mac + Windows
# Line endings managed here — do NOT rely on core.autocrlf
# =============================================================================

# Default: auto-detect text files, normalize to LF in repo
* text=auto eol=lf

# =============================================================================
# Unity YAML files — use UnityYAMLMerge driver
# Prevents scene/prefab merge conflicts from being treated as binary
# =============================================================================
*.unity      merge=unityyamlmerge eol=lf
*.prefab     merge=unityyamlmerge eol=lf
*.asset      merge=unityyamlmerge eol=lf
*.meta       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.anim       merge=unityyamlmerge eol=lf
*.playable   merge=unityyamlmerge eol=lf
*.mat        merge=unityyamlmerge eol=lf
*.lighting   merge=unityyamlmerge eol=lf
*.preset     merge=unityyamlmerge eol=lf
*.spriteatlas merge=unityyamlmerge eol=lf
*.mixer      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.shadervariants     merge=unityyamlmerge eol=lf
*.renderTexture      merge=unityyamlmerge eol=lf
*.flare              merge=unityyamlmerge eol=lf
*.fontsettings       merge=unityyamlmerge eol=lf
*.guiskin            merge=unityyamlmerge eol=lf
*.terrainlayer       merge=unityyamlmerge eol=lf

# =============================================================================
# Binary files — no line ending conversion, no diff
# =============================================================================

# Images
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.bmp        binary
*.tga        binary
*.tiff       binary
*.psd        binary
*.exr        binary
*.hdr        binary
*.ico        binary

# Audio
*.mp3        binary
*.wav        binary
*.ogg        binary
*.aiff       binary
*.aif        binary

# Video
*.mp4        binary
*.mov        binary
*.avi        binary

# 3D models
*.fbx        binary
*.obj        binary
*.blend      binary
*.3ds        binary
*.dae        binary

# Compiled / native
*.dll        binary
*.so         binary
*.a          binary
*.dylib      binary
*.exe        binary
*.apk        binary
*.aab        binary
*.ipa        binary

# Archives
*.zip        binary
*.gz         binary
*.tar        binary
*.7z         binary

# Font
*.ttf        binary
*.otf        binary

# Documents
*.pdf        binary
