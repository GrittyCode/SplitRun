# =============================================================================
# Unity
# =============================================================================

# Generated by Unity — never commit these
Library/
Temp/
Logs/
UserSettings/
obj/
Build/
Builds/

# Unity cache files
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.booproj
*.svd
*.userprefs

# Unity3D generated meta files
*.pidb

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# =============================================================================
# IDE — JetBrains Rider
# =============================================================================
.idea/
*.sln
*.csproj
*.user
*.suo
*.userosscache
*.sln.docstates

# =============================================================================
# IDE — Visual Studio
# =============================================================================
.vs/
[Ll]ocal.settings.json

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# =============================================================================
# Windows
# =============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# =============================================================================
# Sensitive config — API Keys (AdMob App ID, etc.)
# =============================================================================
Assets/Resources/Config/

# =============================================================================
# Asset Store content (paid + free) — EULA prohibits redistribution
# Each publisher's imported folder lives under Assets/AssetStore/<Publisher>/
# Required purchases/imports are documented in README — not committed here
# =============================================================================
Assets/AssetStore/